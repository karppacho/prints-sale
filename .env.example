# URL self-hosted Supabase (адрес Kong/API-гейтвея, например https://supabase.example.com)
VITE_SUPABASE_URL=
# anon key из .env docker-compose Supabase (ANON_KEY)
VITE_SUPABASE_ANON_KEY=
# Домен технической почты: логин хранится как <login>@<домен>, например company.local.
# Должен совпадать с LOGIN_DOMAIN в окружении Edge Function (docs/DB_SETUP.md, п. 3)
VITE_LOGIN_DOMAIN=
# Название в шапке и на экране входа (по умолчанию «Учёт картин»)
VITE_APP_NAME=
# Цены, которыми предзаполняется приход тиража, ₽ (пусто — вводятся вручную)
VITE_DEFAULT_PRICE_UNFRAMED=
VITE_DEFAULT_PRICE_FRAMED=
